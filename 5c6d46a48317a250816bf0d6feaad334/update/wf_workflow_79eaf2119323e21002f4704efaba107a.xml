        <value>const MED_TABLE =  "x_110383_home_me_0_medicines";&#13;
const COMPANY_TABLE = "core_company";&#13;
&#13;
try {&#13;
&#13;
	let grMedicine = new GlideRecord(MED_TABLE);&#13;
	grMedicine.initialize();&#13;
	grMedicine.setValue("name", current.variables.medicine_name);&#13;
	grMedicine.setValue("type", current.variables.type_of_medicine);&#13;
&#13;
	if (current.variables.company_unavailable) {&#13;
		let grManufacturer = new GlideRecord(COMPANY_TABLE);&#13;
		grManufacturer.initialize();&#13;
		grManufacturer.setValue("name", current.variables.manufacturer_name);&#13;
		grManufacturer.setValue("notes", "Medicine");&#13;
		grManufacturer.insert();&#13;
		&#13;
		grMedicine.setValue("manufacturer", grManufacturer.sys_id);&#13;
&#13;
	} else {&#13;
		grMedicine.setValue("manufacturer", current.variables.manufacturer);&#13;
	}&#13;
&#13;
	grMedicine.insert();&#13;
} catch (err) {&#13;
	current.work_notes = `${err.message}\n ${err.stack}`;&#13;
}</value>
